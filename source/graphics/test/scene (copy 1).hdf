    "materials/m/rocktbrn128.png",
    "materials/m/des_roadedge1.png",
    "materials/m/des_ranchwall1.png",
    "materials/m/vgs_shopwall01_128.png",
    "materials/m/vgs_shopwall01_128.png",
    "materials/m/des_redrock2.png",
    "materials/m/des_redrock1.png",
  }
 ]
]

// -------------------------- OBJECTS --------------------------
[object = "world"
 model  = "models/testworld.obj"
 material = "default"
]
[object = "moldavia"
 model  = "models/moldavia.obj"
 material = "moldavia"
]
[object = "mattest"
 model  = "models/mattest.obj"
 material = "moldavia"
 pos = { 0, 0, -10 }
]
[object = "butruck"
 model  = "models/butruck.obj"
 material = "butruck"
 pos = { 300, 15.6, -2560 }
 rot = { 0, 57, 0 }
]
